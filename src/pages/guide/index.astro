---
import BaseLayout from '@layouts/BaseLayout.astro';
import { 메타, 총차시수 } from '@lib/curriculum';
import { PYODIDE_VERSION, 실행제한밀리초 } from '@lib/pyrun';

const 목차 = [
  { id: 'student', text: '학생용 — 이렇게 쓴다', depth: 2 as const },
  { id: 'teacher', text: '교사용', depth: 2 as const },
  { id: 'doctor', text: '실행기 진단 — 수업 전 점검', depth: 2 as const },
  { id: 'trouble', text: '안 될 때', depth: 2 as const },
];
---

<BaseLayout
  제목="사용법과 실행기 진단"
  설명={`「${메타.과목명}」 웹 교과서 사용법과, 수업 전에 돌려 보는 실행기 점검 도구.`}
  크럼목록={[{ 라벨: '과목 홈', 경로: '/' }, { 라벨: '사용법' }]}
  목차={목차}
  목차제목="사용법"
>
  <div class="hero">
    <span class="hero__eyebrow">안내</span>
    <h1>사용법과 실행기 진단</h1>
    <p class="hero__lead">
      이 교과서를 어떻게 쓰는지, 그리고 전산실 컴퓨터에서 Python 실행기가 실제로
      도는지 수업 전에 확인하는 방법을 담았다.
    </p>
    <div class="hero__meta">
      <span class="chip">{총차시수}차시</span>
      <span class="chip">Pyodide {PYODIDE_VERSION}</span>
    </div>
  </div>

  <div class="article">
    <h2 id="student">
      학생용 — 이렇게 쓴다<a class="heading-anchor" href="#student" aria-hidden="true">#</a>
    </h2>
    <ol>
      <li><strong>왼쪽 트리</strong>에서 차시를 고른다. 오른쪽 목차로 문서 안을 오간다.</li>
      <li>
        상단의 <strong>Python / C 단추</strong>로 예제 언어를 바꾼다. 고른 언어는 다음에 와도
        유지된다.
      </li>
      <li>
        Python 예제에는 <strong>[▶ 실행]</strong> 단추가 있다. 눌러 보고 「확인된 실행 결과」와
        같은지 대조한다.
      </li>
      <li>
        <strong>[고치기]</strong>로 코드를 바꿔 다시 실행할 수 있다. 값을 바꿔 보고 무엇이
        달라지는지 보는 것이 이 교과서를 쓰는 가장 좋은 방법이다.
      </li>
      <li>
        <strong>코드 작성 실습 칸에는 붙여넣기가 되지 않는다.</strong> 직접 쳐 보라는 뜻이다.
      </li>
      <li>확인 문제는 보기를 누르면 곧바로 채점된다. 점수는 저장되지 않는다.</li>
    </ol>

    <div class="box box--info">
      <span class="box__label">C 예제에 실행 단추가 없는 까닭</span>
      <p>
        브라우저에서 C를 실행해 주는 도구가 <strong>한글을 제대로 출력하지 못해</strong> 수업에
        쓸 수 없다고 판단했다. 그래서 C 예제는 실제로 컴파일해 확인한 기대 출력을 함께 싣고,
        <strong>[코드 복사]</strong>로 가져가 전산실 컴파일러에서 돌리게 했다.
      </p>
    </div>

    <h2 id="teacher">
      교사용<a class="heading-anchor" href="#teacher" aria-hidden="true">#</a>
    </h2>
    <ul>
      <li>
        <strong>성취기준 색인</strong>에서 코드별로 어느 차시가 담당하는지 볼 수 있다.
      </li>
      <li>
        <strong>교과서 대조표</strong>로 "우리 학교 교과서의 이 단원이 여기 어디인가"를 찾는다.
        차시마다 아래에도 「교과서에서 찾기」 표가 있다.
      </li>
      <li>
        차시 화면을 그대로 <strong>인쇄</strong>하면 좌우 패널과 실행 단추가 빠지고 본문만
        나온다. 코드 작성 실습 칸은 빈 칸으로 나와 손으로 적을 수 있다.
      </li>
      <li>
        <strong>학생 개인정보를 수집하지 않는다.</strong> 서버도 계정도 없다. 저장하는 것은
        언어·출판사 선택처럼 브라우저 안에 남는 값뿐이다.
      </li>
    </ul>

    <h2 id="doctor">
      실행기 진단 — 수업 전 점검<a class="heading-anchor" href="#doctor" aria-hidden="true">#</a>
    </h2>
    <p>
      Python 실행기는 처음 [실행]을 누를 때 인터넷에서 엔진을 내려받는다. 학교망이 외부 주소를
      막고 있으면 이 단계에서 실패한다. <strong>수업에 쓸 컴퓨터에서 미리 한 번 눌러 보자.</strong>
    </p>

    <div class="doctor">
      <button class="doctor__run" type="button" data-doctor-run>실행기 점검하기</button>
      <p class="doctor__note">
        엔진을 실제로 내려받아 Python 코드 한 줄을 돌려 본다. 약 {PYODIDE_VERSION} 판 기준으로
        수십 MB를 받으므로 처음에는 시간이 걸린다.
      </p>
      <table class="tb doctor__table">
        <tbody>
          <tr><th scope="row">브라우저</th><td data-doctor="ua">—</td></tr>
          <tr><th scope="row">모듈 워커 지원</th><td data-doctor="worker">—</td></tr>
          <tr><th scope="row">엔진 내려받기</th><td data-doctor="load">아직 안 해 봄</td></tr>
          <tr><th scope="row">내려받은 양</th><td data-doctor="size">—</td></tr>
          <tr><th scope="row">Python 실행</th><td data-doctor="run">—</td></tr>
          <tr><th scope="row">한글 출력</th><td data-doctor="hangul">—</td></tr>
          <tr><th scope="row">input() 입력</th><td data-doctor="stdin">—</td></tr>
        </tbody>
      </table>
      <pre class="doctor__log" data-doctor="log" hidden></pre>
    </div>

    <div class="box box--tip">
      <span class="box__label">진단이 실패해도 수업은 할 수 있다</span>
      <p>
        실행기는 <strong>덤으로 붙은 기능</strong>이다. 본문·그림·확인 문제·인쇄는 실행기와
        무관하게 그대로 동작한다. 실행기가 막히면 코드를 복사해 전산실 파이썬에서 돌리면 된다.
      </p>
    </div>

    <h2 id="trouble">
      안 될 때<a class="heading-anchor" href="#trouble" aria-hidden="true">#</a>
    </h2>
    <div class="table-wrap">
      <table class="tb">
        <thead>
          <tr>
            <th scope="col">증상</th>
            <th scope="col">까닭과 대응</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">"실행기를 쓸 수 없다"가 뜬다</th>
            <td>
              학교망이 <code>cdn.jsdelivr.net</code>을 막았을 가능성이 크다. 정보부에 이 주소를
              열어 달라고 요청하거나, 코드를 복사해 전산실 파이썬에서 돌린다.
            </td>
          </tr>
          <tr>
            <th scope="row">{실행제한밀리초 / 1000}초가 넘어 중단된다</th>
            <td>
              끝나지 않는 반복이 있는지 본다. <strong>무엇이 변해서 이 반복이 끝나는가</strong>를
              확인한다. 일부러 오래 걸리는 계산이라면 범위를 줄여 본다.
            </td>
          </tr>
          <tr>
            <th scope="row">입력을 기다리다 멈춘 것 같다</th>
            <td>
              이 실행기는 <code>input()</code>이 나올 때 멈춰 서서 기다리지 않는다.
              <strong>「입력」 칸에 미리 적어 둔 값</strong>을 한 줄씩 가져다 쓴다. 줄이 모자라면
              그 자리에서 오류가 난다. 칸에 줄을 더 채워 넣자.
            </td>
          </tr>
          <tr>
            <th scope="row">한글이 깨져 보인다</th>
            <td>
              실행기에서는 잘 나오는데 전산실 파이썬에서 깨진다면 코드가 아니라 글자 설정
              문제다. 파일을 UTF-8로 저장했는지, 명령 창이 UTF-8인지 확인한다.
            </td>
          </tr>
          <tr>
            <th scope="row">고친 코드가 반영되지 않는다</th>
            <td>
              [고치기]를 눌러 편집 칸이 열린 상태여야 그 내용이 실행된다. [되돌리기]를 누르면
              원래 예제로 돌아간다.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>

<script>
  import { 실행, 미리받기, 엔진상태, PYODIDE_VERSION, 주소설정 } from '@lib/pyrun';

  const BASE = import.meta.env.BASE_URL;
  주소설정((BASE.endsWith('/') ? BASE : BASE + '/') + 'runner/py-worker.js');

  const 칸 = (k: string) => document.querySelector<HTMLElement>(`[data-doctor="${k}"]`);
  const 적기 = (k: string, 글: string, 상태?: 'ok' | 'no') => {
    const el = 칸(k);
    if (!el) return;
    el.textContent = 글;
    el.className = 상태 === 'ok' ? 'is-ok' : 상태 === 'no' ? 'is-no' : '';
  };

  /* 눌러 보기 전에도 알 수 있는 것은 먼저 채운다 */
  적기('ua', navigator.userAgent);
  const 모듈워커됨 = (() => {
    try {
      /* 실제로 만들어 보지 않고는 알 수 없어, 빈 워커로 한 번 시험한다 */
      const b = new Blob([''], { type: 'text/javascript' });
      const u = URL.createObjectURL(b);
      const w = new Worker(u, { type: 'module' });
      w.terminate();
      URL.revokeObjectURL(u);
      return true;
    } catch {
      return false;
    }
  })();
  적기('worker', 모듈워커됨 ? '지원함' : '지원하지 않음', 모듈워커됨 ? 'ok' : 'no');

  document.querySelector<HTMLButtonElement>('[data-doctor-run]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = '점검 중…';
    const log = 칸('log');
    if (log) {
      log.hidden = false;
      log.textContent = '';
    }
    const 적자 = (s: string) => {
      if (log) log.textContent += s + '\n';
    };

    적기('load', '내려받는 중…');
    const 시작 = performance.now();
    const r = await 미리받기();

    if (!r.성공) {
      적기('load', `실패 — ${r.메시지 ?? '알 수 없는 이유'}`, 'no');
      적기('run', '못 해 봄');
      적자('엔진을 받지 못했다. 학교망이 cdn.jsdelivr.net 을 막았을 수 있다.');
      적자('본문 학습에는 지장이 없다. 코드를 복사해 전산실 파이썬에서 돌리자.');
      btn.disabled = false;
      btn.textContent = '다시 점검하기';
      return;
    }

    적기('load', `성공 — ${(r.걸린밀리초 / 1000).toFixed(1)}초`, 'ok');

    /* 내려받기는 워커 안에서 일어나므로 이 창의 performance 에는 잡히지 않는다.
       워커가 스스로 재서 넘겨준 값을 쓴다. */
    const 상태 = 엔진상태();
    적기(
      'size',
      상태.받은바이트
        ? `${(상태.받은바이트 / 1024 / 1024).toFixed(1)}MB (${상태.받은파일수}개 파일)`
        : '측정 불가 — 브라우저가 알려 주지 않음'
    );

    적기('run', '실행 중…');
    const 결과 = await 실행('print("실행 확인")\nprint("한글 출력 확인")\n이름 = input()\nprint("입력:", 이름)\n', '점검\n');

    const 출력 = 결과.출력.filter((o) => o.갈래 === 'out').map((o) => o.글).join('');
    적자(`Pyodide ${PYODIDE_VERSION} · 전체 ${((performance.now() - 시작) / 1000).toFixed(1)}초`);
    적자('--- 실행 결과 ---');
    적자(출력 || '(출력 없음)');

    if (결과.실패 || 결과.끊김) {
      적기('run', `실패 — ${결과.실패 ?? '시간 초과'}`, 'no');
      btn.disabled = false;
      btn.textContent = '다시 점검하기';
      return;
    }
    적기('run', 출력.includes('실행 확인') ? '성공' : '결과가 다르다', 출력.includes('실행 확인') ? 'ok' : 'no');
    적기('hangul', 출력.includes('한글 출력 확인') ? '깨지지 않음' : '깨짐', 출력.includes('한글 출력 확인') ? 'ok' : 'no');
    적기('stdin', 출력.includes('입력: 점검') ? '동작함' : '동작하지 않음', 출력.includes('입력: 점검') ? 'ok' : 'no');

    btn.disabled = false;
    btn.textContent = '다시 점검하기';
  });
</script>

<style>
  .doctor {
    margin: var(--space-5) 0;
    padding: var(--space-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
  }
  .doctor__run {
    font-size: 0.95rem;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-primary);
    background: var(--c-primary);
    color: #fff;
    cursor: pointer;
  }
  .doctor__run:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .doctor__note {
    margin: var(--space-3) 0;
    font-size: 0.86rem;
    color: var(--c-text-soft);
  }
  .doctor__table {
    margin-top: var(--space-4);
    font-size: 0.88rem;
  }
  .doctor__table td {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    word-break: break-all;
  }
  .doctor__table :global(.is-ok) {
    color: var(--c-accent);
    font-weight: 700;
  }
  .doctor__table :global(.is-no) {
    color: var(--warn);
    font-weight: 700;
  }
  .doctor__log {
    margin: var(--space-4) 0 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: pre-wrap;
    background: var(--c-bg);
    border-radius: var(--radius-sm);
    max-height: 16em;
    overflow: auto;
  }
  @media print {
    .doctor {
      display: none;
    }
  }
</style>
