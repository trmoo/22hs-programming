---
import BaseLayout from '@layouts/BaseLayout.astro';
import StandardBadge from '@components/StandardBadge.astro';
import { 메타, 단원목록, slug, 총차시수, 전체성취기준 } from '@lib/curriculum';
import { href } from '@lib/url';

const 목차 = [
  { id: 'units', text: '단원 목록', depth: 2 as const },
  { id: 'standards', text: '성취기준 한눈에', depth: 2 as const },
  { id: 'about', text: '이 교과서에 대하여', depth: 2 as const },
];

/* 집필 진행 상황은 데이터에서 센다.
   손으로 적어 두었더니 2단원을 마친 뒤에도 「2단원을 집필하고 있다」가 남아
   화면이 사실과 어긋났다(2026-08-08). 다시 낡지 않게 상태를 세어 쓴다. */
const 차시전체 = 단원목록.flatMap((u) => u.차시);
const 검토중 = 차시전체.filter((l) => l.상태 === 'review').length;
const 확정 = 차시전체.filter((l) => l.상태 === 'published').length;
const 집필중 = 차시전체.filter((l) => l.상태 === 'draft').length;
---

<BaseLayout
  제목="과목 홈"
  설명={`2022 개정 교육과정 고등학교 「${메타.과목명}」 웹 교과서. 성취기준 ${전체성취기준.length}개, ${총차시수}차시.`}
  목차={목차}
>
  <div class="hero">
    <span class="hero__eyebrow">{메타.과목구분}</span>
    <h1>{메타.과목명}</h1>
    <p class="hero__lead">
      프로그래밍 언어의 개념부터 프로그램을 기획·설계·구현·테스트하는 한 바퀴까지 다룬다.
      Python과 C를 페이지 상단에서 바꿔 가며 학습한다.
    </p>
    <div class="hero__meta">
      <span class="chip">{단원목록.length}개 단원</span>
      <span class="chip">{총차시수}차시</span>
      <span class="chip">성취기준 {전체성취기준.length}개</span>
      <span class="chip">Python · C</span>
    </div>
  </div>

  <div class="article">
    <h2 id="units">단원 목록<a class="heading-anchor" href="#units" aria-hidden="true">#</a></h2>

    <ul class="card-list">
      {
        단원목록.map((u) => (
          <li>
            <a class="link-card" href={href(`/units/${slug(u.단원번호)}/`)}>
              <span class="link-card__no">{u.단원번호}</span>
              <span class="link-card__body">
                <h3>{u.단원명}</h3>
                <p>
                  {u.영역} · 성취기준 {u.성취기준.length}개 · {u.차시.length}차시
                </p>
              </span>
              <span class="link-card__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 id="standards">
      성취기준 한눈에<a class="heading-anchor" href="#standards" aria-hidden="true">#</a>
    </h2>
    <p>
      이 교과서의 모든 차시는 성취기준에 매핑된다. 코드를 누르면 그 성취기준을 담당하는
      차시로 갈 수 있다.
    </p>

    <div class="table-wrap">
      <table class="tb">
        <thead>
          <tr>
            <th scope="col">코드</th>
            <th scope="col">영역</th>
            <th scope="col">성취기준</th>
          </tr>
        </thead>
        <tbody>
          {
            단원목록.flatMap((u) =>
              u.성취기준.map((s) => (
                <tr>
                  <td><StandardBadge 코드={s.코드} /></td>
                  <td style="white-space:nowrap">{u.영역}</td>
                  <td>{s.본문}</td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>

    <h2 id="about">
      이 교과서에 대하여<a class="heading-anchor" href="#about" aria-hidden="true">#</a>
    </h2>

    <div class="box box--info">
      <span class="box__label">성취기준 코드는 「프그」다</span>
      <p>
        「{메타.과목명}」은 NCS(국가 직무 능력 표준) 기반 전문 교과 기초 과목이라
        [별책 4] 고등학교 교육과정 「정보과」에 실려 있지 않다. 검정 교과서 6종에도
        코드는 인쇄되어 있지 않아 한동안 잠정 번호를 썼다.
      </p>
      <p>
        <strong>2026년 8월 7일에 코드를 확보했다.</strong> 접두어는 <code>프그</code>이며
        학년군 접두(<code>12</code>)가 붙지 않는다. 근거는 「고등학교 프로그래밍(파이썬)
        교수학습 및 평가 운영 계획」이고, 성취기준 본문은 이 문서와 성림출판 교과서
        <strong>두 출처가 일치</strong>함을 확인했다.
      </p>
    </div>

    <div class="box">
      <span class="box__label">어느 교과서를 쓰든 찾아올 수 있다</span>
      <p>
        상단의 <strong>교과서 선택</strong>에서 학교에서 쓰는 교과서를 고르면, 단원명 옆에 그
        교과서의 단원명과 쪽수가 함께 표시된다. 전체 대응은
        <a href={href('/crosswalk/')}>교과서 대조표</a>에서 볼 수 있다.
      </p>
    </div>

    <div class="box box--tip">
      <span class="box__label">Python 예제는 눌러서 바로 돌아간다</span>
      <p>
        Python 예제에는 <strong>[▶ 실행]</strong> 단추가 있다. 설치 없이 브라우저에서 그대로
        돌아가고, <strong>[고치기]</strong>로 값을 바꿔 다시 실행해 볼 수 있다. C 예제는
        브라우저에서 실행하지 않고 확인된 기대 출력을 함께 싣는다.
      </p>
      <p>
        수업에 쓸 컴퓨터에서 실행기가 도는지 미리 확인하려면
        <a href={href('/guide/#doctor')}>사용법과 실행기 진단</a>에서 점검해 보자.
      </p>
    </div>

    {
      집필중 + 검토중 > 0 && (
        <div class="box box--draft">
          <span class="box__label">집필 진행 상황</span>
          <p>
            {집필중 > 0 ? (
              <>
                <strong>
                  {총차시수}차시 가운데 {총차시수 - 집필중}차시
                </strong>
                의 본문이 집필됐다. 아직 본문이 없는 차시도 학습 목표·핵심 개념·교과서 대조 정보는
                볼 수 있다.
              </>
            ) : (
              <>
                <strong>{총차시수}차시 본문이 모두 집필됐다.</strong> 다만 {검토중}차시는 아직
                <strong> 교사 검토를 거치지 않았다.</strong> 자동 검사는 전부 통과했지만 설명이
                어색한 곳이나 오탈자가 남아 있을 수 있다.
              </>
            )}
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
