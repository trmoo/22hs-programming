{
  "name": "hs-programming-webtextbook",
  "version": "0.0.1",
  "private": true,
  "description": "2022 개정 교육과정 고등학교 「프로그래밍」 웹 교과서",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run check:data && npm run check:content && npm run check:toc && npm run check:examples && astro build && npm run check:html",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run check:data && npm run check:content && npm run check:toc && npm run check:examples",
    "check:content": "node tools/check-content.mjs",
    "check:examples": "node tools/check-examples.mjs",
    "check:data": "node tools/validate-curriculum.mjs content/curriculum.json",
    "check:curriculum": "node tools/validate-curriculum.mjs content/curriculum.json",
    "check:example": "node tools/validate-curriculum.mjs content/curriculum.example.json",
    "check:all": "node tools/validate-curriculum.mjs content/curriculum.json content/curriculum.example.json",
    "check:todo": "node tools/validate-curriculum.mjs content/curriculum.json --todo-only && node tools/check-content.mjs --todo-only",
    "check:toc": "node tools/test-toc.mjs",
    "check:html": "node tools/check-html.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "astro": "^7.1.6"
  }
}
